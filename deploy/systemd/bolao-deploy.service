[Unit]
Description=Bolão da Copa — Auto Deploy (verifica nova imagem e faz rollout)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=cesar-menegatti
Group=cesar-menegatti
WorkingDirectory=/home/cesar-menegatti/js/bolao-da-copa
EnvironmentFile=-/home/cesar-menegatti/js/bolao-da-copa/.env
ExecStart=/home/cesar-menegatti/js/bolao-da-copa/scripts/auto-deploy.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bolao-auto-deploy

# Tempo máximo para um deploy completo (pull + migrate + healthcheck)
TimeoutStartSec=300
